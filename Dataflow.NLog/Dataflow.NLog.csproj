<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Version>0.8.0</Version>
    <Description>NLog target for the HuginnLabs Dataflow SDK — ships log events through the Dataflow log pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="5.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dataflow.Sdk\Dataflow.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test assembly asserts on the level-mapping seam directly. -->
    <InternalsVisibleTo Include="Dataflow.NLog.Tests" />
  </ItemGroup>

</Project>
